<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#1a1a2e"/>
      <stop offset="100%" stop-color="#0f0f1a"/>
    </radialGradient>
    <linearGradient id="hand" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff844a"/>
      <stop offset="50%" stop-color="#ff6b2b"/>
      <stop offset="100%" stop-color="#e55a1f"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ff844a" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#ff844a" stop-opacity="0"/>
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  
  <!-- Tech grid pattern -->
  <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#333" stroke-width="0.5" opacity="0.3"/>
  </pattern>
  <rect width="1200" height="630" fill="url(#grid)"/>
  
  <!-- Central glow -->
  <circle cx="600" cy="315" r="300" fill="url(#glow)" opacity="0.3"/>
  
  <!-- Hand silhouette -->
  <g transform="translate(500, 200)">
    <!-- Palm -->
    <ellipse cx="100" cy="150" rx="80" ry="120" fill="url(#hand)" opacity="0.9"/>
    
    <!-- Fingers -->
    <ellipse cx="60" cy="80" rx="15" ry="60" fill="url(#hand)" transform="rotate(-10 60 80)"/>
    <ellipse cx="85" cy="60" rx="15" ry="70" fill="url(#hand)" transform="rotate(5 85 60)"/>
    <ellipse cx="115" cy="65" rx="15" ry="65" fill="url(#hand)" transform="rotate(15 115 65)"/>
    <ellipse cx="140" cy="85" rx="15" ry="55" fill="url(#hand)" transform="rotate(25 140 85)"/>
    
    <!-- Thumb -->
    <ellipse cx="40" cy="130" rx="12" ry="45" fill="url(#hand)" transform="rotate(-45 40 130)"/>
  </g>
  
  <!-- Tech circles and elements -->
  <g opacity="0.6">
    <!-- Central tech circle -->
    <circle cx="600" cy="315" r="80" fill="none" stroke="#ff844a" stroke-width="2" opacity="0.8"/>
    <circle cx="600" cy="315" r="60" fill="none" stroke="#ff844a" stroke-width="1" opacity="0.6"/>
    <circle cx="600" cy="315" r="40" fill="none" stroke="#ff844a" stroke-width="1" opacity="0.4"/>
    
    <!-- Tech dots -->
    <circle cx="580" cy="295" r="3" fill="#ff844a"/>
    <circle cx="620" cy="335" r="3" fill="#ff844a"/>
    <circle cx="590" cy="340" r="2" fill="#ff844a" opacity="0.7"/>
    <circle cx="610" cy="290" r="2" fill="#ff844a" opacity="0.7"/>
  </g>
  
  <!-- Circuit lines -->
  <g stroke="#ff844a" stroke-width="1" fill="none" opacity="0.4">
    <path d="M 400 315 L 500 315 L 520 295 L 540 295"/>
    <path d="M 660 315 L 760 315 L 780 335 L 800 335"/>
    <path d="M 600 200 L 600 100 L 620 80 L 640 80"/>
    <path d="M 600 430 L 600 530 L 580 550 L 560 550"/>
  </g>
  
  <!-- Floating particles -->
  <g fill="#ff844a" opacity="0.6">
    <circle cx="300" cy="150" r="2"/>
    <circle cx="900" cy="200" r="1.5"/>
    <circle cx="200" cy="400" r="1"/>
    <circle cx="1000" cy="450" r="2"/>
    <circle cx="150" cy="300" r="1.5"/>
    <circle cx="1050" cy="300" r="1"/>
  </g>
  
  <!-- Title -->
  <text x="600" y="550" font-family="Arial, sans-serif" font-size="48" font-weight="bold" text-anchor="middle" fill="#ffffff">
    Interajai Métricas
  </text>
  
  <!-- Subtitle -->
  <text x="600" y="590" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#cccccc">
    Painel para acompanhamento de métricas de marketing
  </text>
</svg>